                                <Border Background="WhiteSmoke" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" ClipToBounds="True" HorizontalAlignment="Right">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FontWeight="Normal" Margin="2">
                                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}, Path=Metadata.AdditionalActions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
