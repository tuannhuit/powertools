                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="25 0 0 0">
                            <TextBlock Style="{StaticResource TextBlock.ContentSmall}" Text="{Binding Metadata.PageInformation, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}}" HorizontalAlignment="Right" Margin="10 5"/>
                            <TextBlock Style="{StaticResource TextBlock.ContentSmall}" HorizontalAlignment="Right" Margin="10 5" Visibility="{Binding Metadata.PageInformation, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}Total Items: {0}">
                                        <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button Style="{StaticResource Button.Icon}" Content="{x:Static models:ButtonIcons.Left}" Command="{Binding Metadata.InvokeAction, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}}" CommandParameter="MovePreviousPage" IsEnabled="{Binding Metadata.IsFirstPage, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}, Converter={StaticResource BoolToReverseConverter}}" FontSize="13" Margin="0 5 0 5" Padding="0" MinWidth="0" MinHeight="0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Button.Icon}" Content="{x:Static models:ButtonIcons.Right}" Command="{Binding Metadata.InvokeAction, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}}" CommandParameter="MoveNextPage" IsEnabled="{Binding Metadata.IsLastPage, RelativeSource={RelativeSource AncestorType=controls:PaginationDataGrid}, Converter={StaticResource BoolToReverseConverter}}" FontSize="13" Margin="0 5 5 5" Padding="0" MinWidth="0" MinHeight="0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="DataGridTemplate.Normal" TargetType="{x:Type DataGrid}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false" Grid.Row="0">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Command="{x:Static DataGrid.SelectAllCommand}" Focusable="false" Style="{DynamicResource {ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}}" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="1" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Grid.ColumnSpan="2" Grid.Row="1"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Maximum="{TemplateBinding ScrollableHeight}" Orientation="Vertical" Grid.Row="1" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                <Grid Grid.Column="1" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Maximum="{TemplateBinding ScrollableWidth}" Orientation="Horizontal" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextBlock.ContentSmall}" Text="{Binding DataContext.PageInformation, RelativeSource={RelativeSource AncestorType=DataGrid}}" HorizontalAlignment="Right" Margin="10 5"/>
                        <TextBlock Style="{StaticResource TextBlock.ContentSmall}" HorizontalAlignment="Right" Margin="10 5" Visibility="{Binding DataContext.PageInformation, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Total Items: {0}">
                                    <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <DataTemplate DataType="{x:Type models:Criteria}">
        <Grid Background="{StaticResource Background.WhiteSmoke}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource TextBlock.ContentSmall}"
                       Text="123&#x0a;abc"
                       FontSize="8"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="5 2 0 0"/>
            <controls:TextPlaceHolder x:Name="txbFilterInput" Grid.Column="1"
                                      Model="{Binding}"
                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      PlaceHolder="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                      BorderThickness="0" BorderBrush="Transparent"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:RangeCriteria}">
        <Grid Background="{StaticResource Background.WhiteSmoke}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0"
                       Style="{StaticResource TextBlock.ContentSmall}"
                       Text="from"
                       FontSize="8"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="5 2 0 0"/>
            <TextBlock Grid.Column="0" Grid.Row="1"
                       Style="{StaticResource TextBlock.ContentSmall}"
                       Text="to"
                       FontSize="8"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="5 2 0 0"/>
            <controls:TextPlaceHolder Grid.Column="1" Grid.Row="0"
