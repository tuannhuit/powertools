                                      PlaceHolder="{Binding Description2, UpdateSourceTrigger=PropertyChanged}" 
                                      BorderThickness="0" BorderBrush="Transparent"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="DataGridColumnHeader.PaginationDataGrid.Normal" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="WhiteSmoke"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="0 1 2 2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 8"/>
                                <TextBlock x:Name="tblSortIcon" Grid.Column="1" Style="{StaticResource TextBlock.Icon}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5" Cursor="SizeWE" Background="Transparent">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent" Width="{TemplateBinding Width}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                            <Border x:Name="gFilter" Grid.Row="1" Visibility="Collapsed" BorderBrush="LightGray" Background="{TemplateBinding Background}" BorderThickness="0" Margin="1">
                                <ContentControl MinHeight="28" Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=Column.FilterModel, UpdateSourceTrigger=PropertyChanged}" SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=IsFiltersVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:PaginationDataGrid}}}" 
                                     Value="True">
                            <Setter TargetName="gFilter" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="SortDirection"  Value="Ascending">
                            <Setter TargetName="tblSortIcon" Property="Text" Value="{x:Static models:ButtonIcons.Up}" />
                            <Setter TargetName="tblSortIcon" Property="Margin" Value="2 0" />
                        </Trigger>
                        <Trigger Property="SortDirection"  Value="Descending">
                            <Setter TargetName="tblSortIcon" Property="Text" Value="{x:Static models:ButtonIcons.Down}" />
                            <Setter TargetName="tblSortIcon" Property="Margin" Value="2 0" />
                        </Trigger>
                        <Trigger Property="Content"  Value="{x:Null}">
                            <Setter TargetName="gFilter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridColumnHeader.Normal" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                                <TextBlock x:Name="tblSortIcon" Grid.Column="1" Style="{StaticResource TextBlock.Icon}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5" Cursor="SizeWE" Background="Transparent">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent" Width="{TemplateBinding Width}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection"  Value="Ascending">
                            <Setter TargetName="tblSortIcon" Property="Text" Value="{x:Static models:ButtonIcons.Up}" />
                            <Setter TargetName="tblSortIcon" Property="Margin" Value="2 0" />
                        </Trigger>
                        <Trigger Property="SortDirection"  Value="Descending">
                            <Setter TargetName="tblSortIcon" Property="Text" Value="{x:Static models:ButtonIcons.Down}" />
                            <Setter TargetName="tblSortIcon" Property="Margin" Value="2 0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
