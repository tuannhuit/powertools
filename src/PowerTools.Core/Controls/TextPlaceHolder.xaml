<UserControl x:Class="PowerTools.Core.Controls.TextPlaceHolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl"
             FontWeight="Normal"
             VerticalAlignment="Top" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PowerTools.Core;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ElementName=UserControl, Path=CmdEnterKeyPressed}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Visibility="{Binding ElementName=UserControl, Path=Title, Converter={StaticResource ValueToVisibilityConverter}}" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0 0 1 0" BorderBrush="Gray">
            <TextBlock Text="{Binding ElementName=UserControl, Path=Title, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 0" FontWeight="Normal" Foreground="Gray"/>
        </Border>
        <Grid Grid.Column="1" Background="{Binding ElementName=UserControl, Path=Background}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <TextBlock Text="{Binding ElementName=UserControl, Path=PlaceHolder, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 28 0" Padding="5 7 28 3" Visibility="{Binding ElementName=UserControl, Path=Text, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Foreground="Gray" FontSize="11"/>
            <TextBox Style="{StaticResource TextBox.ContentSmall}" 
                     Text="{Binding ElementName=UserControl, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding ElementName=UserControl, Path=IsReadOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Margin="0" Padding="3 3 28 3" BorderThickness="0" BorderBrush="Transparent"/>
            <Button Style="{StaticResource Button.Icon}"  Content="&#xE0A4;" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="4" MinHeight="20" Height="20" MinWidth="20" Width="20"
                    Click="btnClear_OnClick">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource MultiValueToBooleanConverter}">
                        <Binding ElementName="UserControl" Path="Text" Converter="{StaticResource StringToBooleanConverter}"/>
                        <Binding ElementName="UserControl" Path="IsReadOnly" Converter="{StaticResource BoolToReverseConverter}"/>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
        </Grid>
    </Grid>
</UserControl>
