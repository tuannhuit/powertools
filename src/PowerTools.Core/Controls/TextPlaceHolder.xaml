<UserControl x:Class="PowerTools.Core.Controls.TextPlaceHolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl"
             FontWeight="Normal"
             VerticalAlignment="Top" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PowerTools.Core;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{Binding ElementName=UserControl, Path=Background}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <TextBlock Text="{Binding ElementName=UserControl, Path=PlaceHolder, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="6" Visibility="{Binding ElementName=UserControl, Path=Text, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Foreground="LightGray"/>
        <TextBox Style="{StaticResource TextBox.ContentSmall}" Text="{Binding ElementName=UserControl, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Margin="0" Padding="3 3 26 3" BorderThickness="0" BorderBrush="Transparent">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ElementName=UserControl, Path=CmdEnterKeyPressed}"/>
            </TextBox.InputBindings>
        </TextBox>
        <Button Style="{StaticResource Button.Icon}"  Content="&#xE0A4;" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="4" MinHeight="20" Height="20" MinWidth="20" Width="20" IsEnabled="{Binding ElementName=UserControl, Path=Text, Converter={StaticResource StringToBooleanConverter}}" Click="ButtonBase_OnClick"/>
    </Grid>
</UserControl>
