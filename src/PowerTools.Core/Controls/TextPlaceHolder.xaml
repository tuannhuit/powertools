<UserControl x:Class="PowerTools.Core.Controls.TextPlaceHolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl"
             FontWeight="Normal">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PowerTools.Core;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ElementName=UserControl, Path=PlaceHolder, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="6" Visibility="{Binding ElementName=UserControl, Path=Text, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Foreground="Gray"/>
        <TextBox Style="{StaticResource TextBox.ContentSmall}" Grid.Column="0" Text="{Binding ElementName=UserControl, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Margin="0"/>
        <Button Style="{StaticResource Button.Icon}"  Grid.Column="1" Content="&#xE0A4;" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Margin="0" MinHeight="28" Height="28" MinWidth="28" Width="28" IsEnabled="{Binding ElementName=UserControl, Path=Text, Converter={StaticResource StringToBooleanConverter}}" Click="ButtonBase_OnClick"/>
    </Grid>
</UserControl>
