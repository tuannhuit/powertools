<UserControl x:Class="PowerTools.Core.Controls.TokenTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:PowerTools.Core.Behaviours"
             x:Name="UserControl">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PowerTools.Core;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ElementName=UserControl, Path=CmdEnterKeyPressed}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="0" ItemsSource="{Binding ElementName=UserControl, Path=HighlightTokens}" Visibility="{Binding ElementName=UserControl, Path=DoShowTokens, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Button.IconActive}" Margin="5 5 0 0" Content="{Binding}" Command="{Binding ElementName=UserControl, Path=CmdApplyToken}" CommandParameter="{Binding}" BorderThickness="0" Height="20"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0">
            <Grid>
                <RichTextBox x:Name="HighlighterVisualPanel"
                         IsReadOnly="True"
                         IsHitTestVisible="False"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{Binding ElementName=UserControl, Path=FontFamily, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="{Binding ElementName=UserControl, Path=FontSize, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{Binding ElementName=UserControl, Path=PaddingHighlighter, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
                <TextBox Text="{Binding ElementName=UserControl, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringJsonFormatConverter}}"
                         IsReadOnly="{Binding ElementName=UserControl, Path=IsReadOnly, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{Binding ElementName=UserControl, Path=FontFamily, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="{Binding ElementName=UserControl, Path=FontSize, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{Binding ElementName=UserControl, Path=PaddingTextEditor, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{Binding ElementName=UserControl, Path=ForegroundTextEditor, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         behaviours:TextBoxBehavior.IsFocusedOnLoad="True"
                         behaviours:TextBoxBehavior.InjectTextAtCursor="{Binding ElementName=UserControl, Path=InsertedToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:RichTextBoxBehavior.HighlighterTarget="{Binding ElementName=HighlighterVisualPanel}"
                         behaviours:RichTextBoxBehavior.ActiveTokens="{Binding ElementName=UserControl, Path=HighlightTokens, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         CaretBrush="Black">
                </TextBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
