<Window x:Class="PowerTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:configurations="clr-namespace:PowerTools.Core.Configurations;assembly=PowerTools.Core"
        xmlns:helpers="clr-namespace:PowerTools.Helpers"
        xmlns:userControls="clr-namespace:PowerTools.Views.UserControls"
        xmlns:controls="clr-namespace:PowerTools.Core.Controls;assembly=PowerTools.Core"
        xmlns:models="clr-namespace:PowerTools.Core.SharedServices;assembly=PowerTools.Core"
        xmlns:behaviors="clr-namespace:PowerTools.Core.Behaviours;assembly=PowerTools.Core"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        d:DesignHeight="1200" d:DesignWidth="800"
        Title="PowerTools"
        Background="{StaticResource Background.Default}"
        WindowStartupLocation="CenterScreen" 
        MinWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinWidth}"
        MaxWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxWidth}"
        Width="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Width}"
        MinHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinHeight}"
        MaxHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxHeight}"
        Height="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Height}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="{Binding ViewLogGridLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxHeight="500"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <userControls:SideBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>
        <Grid Grid.Column="1" Grid.Row="0" Margin="5 10 5 0" >
            <Border Background="DarkGray" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5">
                <Border.Effect>
                    <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>
            <Border Margin="0" Background="White" BorderBrush="{StaticResource Background.Gray}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <ContentControl prism:RegionManager.RegionName="{x:Static configurations:Constants.ModuleRegionName}"
                                        Focusable="False"
                                        IsEnabled="{Binding Source={x:Static models:ApplicationService.Instance}, Path=IsFree, UpdateSourceTrigger=PropertyChanged}"/>
                    <userControls:WindowLoading/>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter Style="{StaticResource GridSplitter.Normal}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border Grid.Column="1" Grid.Row="2" Margin="5 0 5 0">
            <TabControl Style="{StaticResource TabControl.Normal}" ItemContainerStyle="{StaticResource TabItem.Simple}" behaviors:TabControlBehavior.CanCloseTabItem="False" Background="White" Margin="0">
                <TabItem Header="Logs">
                    <userControls:LogsView/>
                </TabItem>
                <TabItem Header="Background Jobs">
                    <userControls:BackgroundJobsView/>
                </TabItem>
            </TabControl>
        </Border>
        <Grid Grid.Column="1" Grid.Row="2" Background="White" Visibility="Collapsed" Focusable="False" IsEnabled="False">
            <ContentControl x:Name="ContentControlDialogView"
                            prism:RegionManager.RegionName="{x:Static configurations:Constants.DialogRegionName}"
                            prism:RegionManager.RegionManager="{x:Static helpers:ModuleLoader.DialogRegionManager}"
                            Focusable="False"/>
        </Grid>
        <userControls:StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" />
        <!--<Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" Background="White">
            <StackPanel>
