<Window x:Class="PowerTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:configurations="clr-namespace:PowerTools.Core.Configurations;assembly=PowerTools.Core"
        xmlns:userControls="clr-namespace:PowerTools.Views.UserControls"
        xmlns:behaviours="clr-namespace:PowerTools.Core.Behaviours;assembly=PowerTools.Core"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:data="clr-namespace:PowerTools.Views"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Background="{StaticResource Background.WhiteSmoke}"
        Title="PowerTools"
        WindowStartupLocation="CenterScreen" 
        MinWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinWidth}"
        MaxWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxWidth}"
        Width="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Width}"
        MinHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinHeight}"
        MaxHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxHeight}"
        Height="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Height}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="{Binding ViewLogGridLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxHeight="500"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <userControls:SideBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>
        <ContentControl Grid.Column="1" Grid.Row="0" prism:RegionManager.RegionName="{x:Static configurations:Constants.ModuleRegionName}"
                        Focusable="False"
                        IsEnabled="{Binding IsFree, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
        <userControls:WindowLoading Grid.Column="1" Grid.Row="0"/>
        <GridSplitter Style="{StaticResource GridSplitter.Normal}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
        <userControls:LogsView Grid.Column="1" Grid.Row="2"/>
        <userControls:StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" />
        <!--<Grid Grid.ColumnSpan="2" Grid.RowSpan="4" Margin="5">
            <DataGrid Style="{StaticResource DataGrid.Pagination}" Margin="5 0 0 0" 
                      behaviours:DataGridBehavior.Header="ABC"
                      behaviours:DataGridBehavior.IsFiltersVisible="True"
                      behaviours:DataGridBehavior.Filters="{Binding Source={x:Static data:MainWindow.CriteriaList}, Path=Filters}"
                      behaviours:DataGridBehavior.ColumnSettings="{Binding Source={x:Static data:MainWindow.CriteriaList}, Path=ColumnSettings}"
                      Tag="{Binding MessagesWithFilters, UpdateSourceTrigger=PropertyChanged}" 
                      behaviours:DataGridBehavior.SelectedItem="{Binding SelectedMessage, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" 
                      behaviours:DataGridBehavior.SelectedCellValues="{Binding SelectedMessageCellValues, UpdateSourceTrigger=PropertyChanged}"  
                      SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
                <behaviours:DataGridBehavior.HeaderSettings>
                    <TextBlock Text="ABC"/>
                </behaviours:DataGridBehavior.HeaderSettings>
                <DataGrid.Columns>
                    <DataGridTextColumn behaviours:DataGridBehavior.ColumnName="Column1" Header="Column 1" SortDirection="Ascending"/>
                    <DataGridTextColumn behaviours:DataGridBehavior.ColumnName="Column2" Header="Column 2" Width="200"/>
                    <DataGridTextColumn behaviours:DataGridBehavior.ColumnName="Column3" Header="Column 3"/>
                    <DataGridTextColumn behaviours:DataGridBehavior.ColumnName="Column4" Header="Column 4" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>-->
    </Grid>
</Window>
