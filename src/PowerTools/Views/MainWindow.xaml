                    <controls:PaginationDataGrid.Columns>
                        <controls:PaginationDataGridTextColumn Name="ConsumerGroupId" Header="Consumer Group" Binding="{Binding ConsumerGroupId}" IsReadOnly="True" MinWidth="100"/>
                        <controls:PaginationDataGridTextColumn Name="ConsumerId" Header="Consumer ID" Binding="{Binding ConsumerId}" IsReadOnly="True" MinWidth="100"/>
                        <controls:PaginationDataGridTextColumn Name="Partition" Header="Partition" Binding="{Binding Partition.Value}" IsReadOnly="True" MinWidth="85"/>
                        <controls:PaginationDataGridTextColumn Name="CurrentOffset" Header="Current Offset" Binding="{Binding CurrentOffset, Converter={StaticResource OffsetFormatter}}" IsReadOnly="True" MinWidth="100"/>
                    </controls:PaginationDataGrid.Columns>
                </controls:PaginationDataGrid>--><!--
