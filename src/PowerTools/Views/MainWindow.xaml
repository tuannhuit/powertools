                        <controls:PaginationDataGridTextColumn Name="Partition" Header="Partition" Binding="{Binding Partition.Value}" IsReadOnly="True" MinWidth="85"/>
                        <controls:PaginationDataGridTextColumn Name="CurrentOffset" Header="Current Offset" Binding="{Binding CurrentOffset, Converter={StaticResource OffsetFormatter}}" IsReadOnly="True" MinWidth="100"/>
