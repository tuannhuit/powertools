<Window x:Class="PowerTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:configurations="clr-namespace:PowerTools.Core.Configurations;assembly=PowerTools.Core"
        xmlns:userControls="clr-namespace:PowerTools.Views.UserControls"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Title="PowerTools"
        Background="WhiteSmoke"
        WindowStartupLocation="CenterScreen" 
        MinWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinWidth}"
        MaxWidth="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxWidth}"
        Width="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Width}"
        MinHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MinHeight}"
        MaxHeight="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.MaxHeight}"
        Height="{Binding Source={x:Static configurations:ModuleGlobalSettings.Instance}, Path=WindowSettings.Height}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="{Binding ViewLogGridLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxHeight="500"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <userControls:SideBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>
        <Grid Grid.Column="1" Grid.Row="0" Margin="5 5 10 0" >
            <Border Background="LightGray" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                <Border.Effect>
                    <BlurEffect Radius="5" KernelType="Gaussian" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>
            <Border Margin="1" Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <ContentControl prism:RegionManager.RegionName="{x:Static configurations:Constants.ModuleRegionName}"
                                        Focusable="False"
                                        IsEnabled="{Binding IsFree, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <userControls:WindowLoading/>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter Style="{StaticResource GridSplitter.Normal}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
        <userControls:LogsView Grid.Column="1" Grid.Row="2"/>
        <userControls:StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" />
        <!--<Grid Grid.ColumnSpan="2" Grid.RowSpan="4" Margin="0" Background="White">
            <controls:PaginationDataGrid Header="ABC" 
