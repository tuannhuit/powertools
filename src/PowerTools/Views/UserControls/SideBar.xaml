<UserControl x:Class="PowerTools.Views.UserControls.SideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PowerTools.Core.Models;assembly=PowerTools.Core"
             mc:Ignorable="d" 
             x:Name="userControlSideBar"
             d:DesignHeight="450" d:DesignWidth="250"
             IsEnabled="{Binding IsFree, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
    <Border HorizontalAlignment="Left" BorderThickness="0 0 1 0" BorderBrush="LightGray" Background="{StaticResource Background.WhiteSmoke}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="DarkCyan" Visibility="{Binding IsActiveModuleList, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="2 0 0 0"/>
                <Button Style="{StaticResource Button.Icon}" Grid.Column="1" Content="{x:Static models:ButtonIcons.Module}" Command="{Binding CmdSelectModuleList}" FontSize="24" Width="40" Height="40" Margin="0" ToolTip="Module List"/>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="DarkCyan" Visibility="{Binding IsActive, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="2 0 0 0"/>
                            <Button Style="{StaticResource Button.Icon}" Grid.Column="1" Content="{Binding Icon}" FontSize="24" Width="40" Height="40" Margin="0" Command="{Binding DataContext.CmdNavigateToModule, ElementName=userControlSideBar}" CommandParameter="{Binding Name}" ToolTip="{Binding Name}" IsEnabled="{Binding IsLoadedProperly, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" FontFamily="Segoe UI Symbol" Text="{x:Static models:ButtonIcons.None}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="OrangeRed" FontWeight="Bold" FontSize="14" Margin="5" Visibility="{Binding IsLoadedFailed, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding Name}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Button.Icon}" Grid.Row="2" Content="{x:Static models:ButtonIcons.Setting}" Command="{Binding CmdShowSettings}" FontSize="24" Width="40" Height="40" Margin="0" ToolTip="Settings"/>
        </Grid>
    </Border>
</UserControl>
