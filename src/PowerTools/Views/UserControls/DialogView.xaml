<UserControl x:Class="PowerTools.Views.UserControls.DialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:PowerTools.Core.Models;assembly=PowerTools.Core"
             xmlns:sharedServices="clr-namespace:PowerTools.Core.SharedServices;assembly=PowerTools.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             IsEnabled="{Binding Source={x:Static sharedServices:ApplicationService.Instance}, Path=IsFree, UpdateSourceTrigger=PropertyChanged}">
    <prism:Dialog.WindowStyle>
        <Style TargetType="{x:Type Window}">
            <!-- Set WindowStyle to None and allow transparency for custom styling -->
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SizeToContent" Value="Manual"/>
            <Setter Property="MinWidth" Value="{Binding Source={x:Static models:WindowSettings.MIN_WIDTH}}"/>
            <Setter Property="MinHeight" Value="{Binding Source={x:Static models:WindowSettings.MIN_HEIGHT}}"/>

            <!-- Define the custom drag and resize behavior -->
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <!-- CaptionHeight allows dragging; ResizeBorderThickness enables edge resizing -->
                    <WindowChrome CaptionHeight="45" ResizeBorderThickness="10" GlassFrameThickness="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <!-- 1. ENTRY ANIMATION: Triggers instantly when the parent host window initializes -->
        <Storyboard x:Key="Storyboard.Dialog.Entrance">
            <!-- Smoothly fade opacity from 0% to 100% -->
            <DoubleAnimation Storyboard.TargetName="MainShell" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Zoom scale effect from 92% layout scale up to 100% size -->
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 2. EXIT ANIMATION: Triggered via C# before window teardown takes place -->
        <Storyboard x:Key="Storyboard.Dialog.Exit">
            <DoubleAnimation Storyboard.TargetName="MainShell" Storyboard.TargetProperty="Opacity"
                             To="0.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX"
                             To="0.95" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY"
                             To="0.95" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Triggers the entrance animation as soon as the control loads inside the visual tree -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Storyboard.Dialog.Entrance}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="MainShell" Margin="6">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="MainScale" ScaleX="0.92" ScaleY="0.92"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border Background="LightGray" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5">
            <Border.Effect>
                <BlurEffect Radius="10" KernelType="Gaussian" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <Border Margin="1" Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource Background.Default}" CornerRadius="5 5 0 0"/>
                <TextBlock Style="{StaticResource TextBlock.ContentSmall}" Grid.Row="0" Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="Medium" Margin="10 10 5 5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Actions}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Icon}"
                                    Content="{Binding Icon}"
                                    Tag="{Binding Name}"
                                    Command="{Binding Command}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" 
                                    Margin="5 10 0 5" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Button.IconActive}" 
                        Grid.Row="0" Grid.Column="2" Margin="5 10 10 10" 
                        Content="{x:Static models:ButtonIcons.Cancel}" Tag="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding CloseCommand}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard Storyboard="{StaticResource Storyboard.Dialog.Exit}"/>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" Stroke="WhiteSmoke" StrokeThickness="1"/>
                <ContentControl x:Name="DialogContentHost"
                                DataContext="{Binding ViewModel, UpdateSourceTrigger=PropertyChanged}"
                                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="1" MinWidth="0" MinHeight="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
