<UserControl x:Class="PowerTools.Views.UserControls.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sharedServices="clr-namespace:PowerTools.Core.SharedServices;assembly=PowerTools.Core"
             xmlns:models="clr-namespace:PowerTools.Core.Models;assembly=PowerTools.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 5 0 0">
            <Button Style="{StaticResource Button.Icon}" Command="{Binding CmdClearLogs}" Content="{x:Static models:ButtonIcons.Delete}" Tag="Clear All" ToolTip="Clear logs" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontSize="12" Margin="5 0 5 0" Height="25" MinHeight="25"/>
            <ToggleButton Style="{StaticResource ToggleButton.Icon}" 
                          Content="" Tag="Text Wrapping"
                          IsChecked="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=DoTextWrapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="12" Margin="0 0 5 0" MinWidth="25" MinHeight="25" Height="25"
                          BorderBrush="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=DoTextWrapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToStringConverter}, ConverterParameter='True:LightGray:Transparent'}"
                          VerticalAlignment="Center"/>  
            <ToggleButton Style="{StaticResource ToggleButton.Icon}" 
                          Content="" Tag="Show Time"
                          IsChecked="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=DoShowTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="12" Margin="0 0 5 0" MinWidth="25" MinHeight="25" Height="25"
                          BorderBrush="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=DoShowTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToStringConverter}, ConverterParameter='True:LightGray:Transparent'}"
                          VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox Grid.Row="1" 
                 Text="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=Message, Mode=OneWay}"
                 TextWrapping="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=DoTextWrapping, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToStringConverter}, ConverterParameter='True:Wrap:NoWrap'}"
                 BorderBrush="Transparent" Background="Transparent" Foreground="{StaticResource TextBox.Foreground.Gray}" 
                 FontFamily="Consolas" BorderThickness="0" FontSize="12" IsReadOnly="True" 
                 Padding="2 5" TextChanged="txbLogs_TextChanged"/>
    </Grid>
</UserControl>
