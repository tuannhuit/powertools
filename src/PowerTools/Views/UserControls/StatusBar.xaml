<UserControl x:Class="PowerTools.Views.UserControls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sharedServices="clr-namespace:PowerTools.Core.SharedServices;assembly=PowerTools.Core"
             xmlns:models="clr-namespace:PowerTools.Core.Models;assembly=PowerTools.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!--<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Stroke="Black" StrokeThickness="0.25"/>-->
        <TextBlock Style="{StaticResource TextBlock.ContentSmall}" Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=Status, Mode=OneWay}" FontSize="12" FontFamily="Consolas"  Margin="10 3" MaxHeight="20"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5 1">
            <Button Style="{StaticResource Button.Icon}" Tag="{Binding Source={x:Static sharedServices:TaskExecution.Instance}, Path=TasksInformation, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 100 0" Height="20" MinHeight="20" BorderThickness="0" />
            <Button Style="{StaticResource Button.IconHighlight}" Content="{x:Static models:ButtonIcons.Information}" Tag="New version available" ToolTip="Click to update version" Margin="0" Height="20" MinHeight="20" BorderThickness="0" Background="{StaticResource Background.Red}" FontWeight="SemiBold" Visibility="{Binding Source={x:Static sharedServices:ApplicationService.Instance}, Path=HasNewVersion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Style="{StaticResource Button.Icon}" Command="{Binding CmdShowLog}" Content="{x:Static models:ButtonIcons.ShowLogs}" ToolTip="Click to view logs" Margin="10 0" Height="20" MinHeight="20" />
        </StackPanel>
    </Grid>
</UserControl>
