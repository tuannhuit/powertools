<UserControl x:Class="PowerTools.Views.UserControls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sharedServices="clr-namespace:PowerTools.Core.SharedServices;assembly=PowerTools.Core"
             xmlns:models="clr-namespace:PowerTools.Core.Models;assembly=PowerTools.Core"
             xmlns:behaviours="clr-namespace:PowerTools.Core.Behaviours;assembly=PowerTools.Core"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="800" 
             Background="{StaticResource Background.LightBar}">
    <Grid VerticalAlignment="Bottom" Margin="0 3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TextBlock.ContentSmall}" Grid.Column="0" Text="{Binding Source={x:Static sharedServices:LoggingService.Instance}, Path=Status, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Margin="10 0 0 0" MaxHeight="20" MinHeight="20" Padding="0 3 0 0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 0">
            <Button Style="{StaticResource Button.Icon}" Tag="{Binding Source={x:Static sharedServices:TaskExecution.Instance}, Path=TasksInformation, UpdateSourceTrigger=PropertyChanged}" Margin="5 0 0 0"  Height="20" MinHeight="20" Width="120"/>
            <Button Style="{StaticResource Button.Icon}" Command="{Binding CmdShowLog}" Content="{x:Static models:ButtonIcons.ShowLogs}" ToolTip="Click to view logs" Margin="5 0" Height="20" MinHeight="20"/>
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="{Binding Path=AppVersion.NewVersionUpdateAsString, UpdateSourceTrigger=PropertyChanged}"
                        Command="{Binding Path=AppVersion.CmdUpdateToLatestVersion}"
                        Margin="0" BorderThickness="0 0 1 0" BorderBrush="LightGray"
                        behaviours:ButtonBehavior.CornerRadius="3 0 0 3"
                        Width="120">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Button.IconHighlight}">
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="MinHeight" Value="20"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=AppVersion.Status, UpdateSourceTrigger=PropertyChanged}" Value="NoUpdates">
                                    <Setter Property="Background" Value="{StaticResource Background.LightGray}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBox.Foreground.Gray}"/>
                                    <Setter Property="Tag" Value="Check for Updates"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AppVersion.Status, UpdateSourceTrigger=PropertyChanged}" Value="CheckForUpdates">
                                    <Setter Property="Background" Value="{StaticResource Background.LightGray}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBox.Foreground.Gray}"/>
                                    <Setter Property="IsEnabled" Value="false"/>
                                    <Setter Property="Tag" Value="Checking new version"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AppVersion.Status, UpdateSourceTrigger=PropertyChanged}" Value="Updating">
                                    <Setter Property="IsEnabled" Value="false"/>
                                    <Setter Property="Tag" Value="Downloading ..."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AppVersion.Status, UpdateSourceTrigger=PropertyChanged}" Value="HasNewVersion">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Tag" Value="{Binding Path=AppVersion.NewVersion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringFormatConverter}, ConverterParameter='Update v{0}'}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AppVersion.Status, UpdateSourceTrigger=PropertyChanged}" Value="Done">
                                    <Setter Property="Background" Value="{StaticResource Background.LightGray}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBox.Foreground.Gray}"/>
                                    <Setter Property="Tag" Value="Restart"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource Button.IconActive}"
                            Tag="{Binding Path=AppVersion.CurrentVersion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringFormatConverter}, ConverterParameter='v{0}'}" 
                            Command="{Binding Path=AppVersion.CmdShowReleaseInformation}"
                            Margin="0" Height="20" MinHeight="20" MinWidth="50"
                            BorderThickness="0"
                            behaviours:ButtonBehavior.CornerRadius="0 3 3 0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
